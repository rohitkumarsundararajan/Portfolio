import * as THREE from 'three'

const W = 1024
const H = 704
const INK = '10,10,10'
const CX = 700
const CY = 270

function rng(seed) {
  let a = seed
  return () => {
    a |= 0
    a = (a + 0x6d2b79f5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

// Projects: nested rounded squares
function nested(g) {
  for (let i = 0; i < 12; i++) {
    const s = 80 + i * 40
    g.strokeStyle = `rgba(${INK},${0.9 - i * 0.065})`
    g.lineWidth = 2
    g.beginPath()
    g.roundRect(CX - s / 2 + i * 7, CY - s / 2 - i * 4, s, s, 14 + i * 2)
    g.stroke()
  }
  g.fillStyle = `rgb(${INK})`
  g.beginPath()
  g.roundRect(CX - 40, CY - 40, 80, 80, 14)
  g.fill()
}

// Internships: striped disc
function stripes(g) {
  g.save()
  g.beginPath()
  g.arc(CX, CY, 200, 0, Math.PI * 2)
  g.clip()
  g.strokeStyle = `rgb(${INK})`
  g.lineWidth = 7
  for (let x = -400; x < 1200; x += 22) {
    g.beginPath()
    g.moveTo(x, CY + 300)
    g.lineTo(x + 360, CY - 300)
    g.stroke()
  }
  g.restore()
  g.lineWidth = 2
  g.strokeStyle = `rgba(${INK},0.5)`
  g.beginPath()
  g.arc(CX, CY, 240, 0, Math.PI * 2)
  g.stroke()
  g.fillStyle = `rgb(${INK})`
  g.beginPath()
  g.arc(CX - 160, CY + 150, 36, 0, Math.PI * 2)
  g.fill()
}

// Achievements: sunburst medal
function sunburst(g) {
  const rays = 56
  for (let i = 0; i < rays; i++) {
    const a = (i / rays) * Math.PI * 2
    const r1 = 70
    const r2 = i % 2 ? 190 : 250
    g.strokeStyle = `rgba(${INK},${i % 2 ? 0.45 : 0.9})`
    g.lineWidth = i % 2 ? 2 : 4
    g.beginPath()
    g.moveTo(CX + Math.cos(a) * r1, CY + Math.sin(a) * r1)
    g.lineTo(CX + Math.cos(a) * r2, CY + Math.sin(a) * r2)
    g.stroke()
  }
  g.fillStyle = `rgb(${INK})`
  g.beginPath()
  g.arc(CX, CY, 46, 0, Math.PI * 2)
  g.fill()
  g.lineWidth = 2
  g.strokeStyle = `rgba(${INK},0.4)`
  g.beginPath()
  g.arc(CX, CY, 290, 0, Math.PI * 2)
  g.stroke()
}

// CP: contribution-style grid
function contrib(g) {
  const rand = rng(7)
  const levels = [0.06, 0.06, 0.14, 0.3, 0.55, 1]
  const size = 30
  const gap = 9
  for (let r = 0; r < 10; r++) {
    for (let c = 0; c < 16; c++) {
      const a = levels[Math.floor(Math.pow(rand(), 1.4) * levels.length)]
      g.fillStyle = `rgba(${INK},${a})`
      g.beginPath()
      g.roundRect(380 + c * (size + gap), 70 + r * (size + gap), size, size, 7)
      g.fill()
    }
  }
}

// Tech Stacks: hexagon grid
function hexes(g) {
  const rand = rng(21)
  const r = 44
  const w = Math.sqrt(3) * r
  for (let row = 0; row < 6; row++) {
    for (let col = 0; col < 8; col++) {
      const cx = 400 + col * w + (row % 2 ? w / 2 : 0)
      const cy = 90 + row * r * 1.5
      g.beginPath()
      for (let k = 0; k < 6; k++) {
        const a = Math.PI / 6 + (k * Math.PI) / 3
        const x = cx + r * 0.9 * Math.cos(a)
        const y = cy + r * 0.9 * Math.sin(a)
        if (k) g.lineTo(x, y)
        else g.moveTo(x, y)
      }
      g.closePath()
      const v = rand()
      if (v > 0.72) {
        g.fillStyle = `rgb(${INK})`
        g.fill()
      } else if (v > 0.45) {
        g.fillStyle = `rgba(${INK},0.12)`
        g.fill()
      }
      g.strokeStyle = `rgba(${INK},0.55)`
      g.lineWidth = 2
      g.stroke()
    }
  }
}

// Certificates: wavy rosette seal
function rosette(g) {
  for (let k = 0; k < 11; k++) {
    const base = 40 + k * 22
    g.strokeStyle = `rgba(${INK},${0.9 - k * 0.07})`
    g.lineWidth = 2
    g.beginPath()
    for (let i = 0; i <= 360; i++) {
      const t = (i / 360) * Math.PI * 2
      const rr = base + 7 * Math.sin(14 * t + k * 0.6)
      const x = CX + rr * Math.cos(t)
      const y = CY + rr * Math.sin(t)
      if (i) g.lineTo(x, y)
      else g.moveTo(x, y)
    }
    g.closePath()
    g.stroke()
  }
  g.fillStyle = `rgb(${INK})`
  g.beginPath()
  g.arc(CX, CY, 22, 0, Math.PI * 2)
  g.fill()
}

const DESIGNS = {
  projects: nested,
  internships: stripes,
  achievements: sunburst,
  cp: contrib,
  stacks: hexes,
  certificates: rosette,
}

export function makeCardTexture({ title, index, id }) {
  const canvas = document.createElement('canvas')
  canvas.width = W
  canvas.height = H
  const g = canvas.getContext('2d')

  const bg = g.createLinearGradient(0, 0, 0, H)
  bg.addColorStop(0, '#fbfbfa')
  bg.addColorStop(1, '#ececea')
  g.fillStyle = bg
  g.fillRect(0, 0, W, H)

  const design = DESIGNS[id]
  if (design) design(g)

  // title bottom-left (shrinks to fit long names)
  g.fillStyle = `rgb(${INK})`
  g.textBaseline = 'alphabetic'
  let fs = 64
  g.font = `400 ${fs}px Arial, sans-serif`
  while (g.measureText(title).width > 760 && fs > 34) {
    fs -= 2
    g.font = `400 ${fs}px Arial, sans-serif`
  }
  g.fillText(title, 56, H - 64)

  // round arrow button bottom-right
  const cx = W - 110
  const cy = H - 96
  g.beginPath()
  g.arc(cx, cy, 44, 0, Math.PI * 2)
  g.fillStyle = '#000'
  g.fill()
  g.strokeStyle = '#fff'
  g.lineWidth = 5
  g.lineCap = 'round'
  g.lineJoin = 'round'
  g.beginPath()
  g.moveTo(cx - 12, cy + 12)
  g.lineTo(cx + 12, cy - 12)
  g.moveTo(cx - 2, cy - 12)
  g.lineTo(cx + 12, cy - 12)
  g.lineTo(cx + 12, cy + 2)
  g.stroke()

  const texture = new THREE.CanvasTexture(canvas)
  texture.anisotropy = 4
  return texture
}